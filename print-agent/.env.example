# ─── Supabase ─────────────────────────────────────────────────────────────────
# ATENÇÃO: a service key dá acesso total ao banco. Este arquivo fica no PC do
# restaurante — não compartilhe, não coloque em pendrive, não mande por WhatsApp.
SUPA_URL=https://XXXXXXXXXXXX.supabase.co
SUPA_SERVICE_KEY=eyJXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Impressora ───────────────────────────────────────────────────────────────
# Escolha UMA forma de conectar:
#
# 1) Impressora de REDE (recomendado — mais estável). Descubra o IP no menu de
#    autoteste da impressora (segure o botão FEED ao ligar). Porta quase sempre 9100:
PRINTER_INTERFACE=tcp://192.168.0.87:9100
#
# 2) Impressora USB compartilhada no Windows. Compartilhe ela com um nome SEM
#    espaços (ex: TERMICA) em Impressoras → Propriedades → Compartilhamento:
# PRINTER_INTERFACE=//localhost/TERMICA
#
# 3) Impressora USB no Linux (o usuário precisa ter permissão no device):
# PRINTER_INTERFACE=/dev/usb/lp0

# Perfil de comandos ESC/POS. EPSON funciona na maioria das térmicas genéricas.
# Se sair sujeira no papel, tente STAR, DARUMA ou TANCA.
PRINTER_TIPO=EPSON

# Colunas de texto: 48 para bobina de 80mm, 32 para bobina de 58mm.
PRINTER_LARGURA=48

# Quantas vias imprimir por pedido (2 = uma pra cozinha, uma pro entregador).
VIAS=1

# ─── Comportamento ────────────────────────────────────────────────────────────
# De quanto em quanto tempo checar se tem pedido novo (ms).
INTERVALO_MS=3000
# Depois de N falhas seguidas, o pedido para de ser tentado para não travar a
# fila (fica marcado com o erro na coluna impressao_erro da tabela pedidos).
MAX_TENTATIVAS=5

TZ_RESTAURANTE=America/Sao_Paulo
NOME_RESTAURANTE=RESTAURANTE CHAPELAO
