# ═══════════════════════════════════════════════════════════════
#  CONFIGURAÇÃO DA IMPRESSÃO AUTOMÁTICA — RESTAURANTE CHAPELÃO
#  Preencha as 3 linhas marcadas com  <<< PREENCHER
# ═══════════════════════════════════════════════════════════════

# ─── 1. A IMPRESSORA ──────────────────────────────────────────
# Impressora ligada por USB no notebook (o seu caso):
# escreva "windows:" seguido do nome EXATO que aparece em
# Configurações → Bluetooth e dispositivos → Impressoras e scanners.
# O 1-INSTALAR.bat mostra a lista pronta pra você copiar.
#
PRINTER_INTERFACE=windows:NOME DA IMPRESSORA          # <<< PREENCHER
#
# (Se um dia trocar por impressora de rede, use assim:)
# PRINTER_INTERFACE=tcp://192.168.0.87:9100

# Perfil de comandos. EPSON funciona na maioria das térmicas.
# Se sair sujeira no papel, tente: STAR, DARUMA, TANCA
PRINTER_TIPO=EPSON

# Largura do papel: 48 para bobina de 80mm, 32 para bobina de 58mm.
PRINTER_LARGURA=48

# Quantas vias imprimir por pedido (2 = uma pra cozinha, uma pro entregador)
VIAS=1

# ─── 2. ACESSO AO BANCO ───────────────────────────────────────
# Peça estes dois valores pra quem cuida do sistema, ou pegue em
# supabase.com → seu projeto → Settings → API.
#
SUPA_URL=https://qlswjefuinhbtlhauhgj.supabase.co
SUPA_SERVICE_KEY=COLE_AQUI_A_SERVICE_ROLE_KEY          # <<< PREENCHER

# ─── 3. AJUSTES (pode deixar como está) ───────────────────────
# De quanto em quanto tempo checar se tem pedido novo (milissegundos)
INTERVALO_MS=3000

# Depois de N falhas seguidas, o pedido para de ser tentado pra não
# travar a fila. O motivo fica gravado no banco.
MAX_TENTATIVAS=5

TZ_RESTAURANTE=America/Sao_Paulo
NOME_RESTAURANTE=RESTAURANTE CHAPELAO
