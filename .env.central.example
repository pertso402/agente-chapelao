# Ativar só após preparar banco, equipe, worker e corte dos webhooks.
CENTRAL_ENABLED=true
APP_ORIGIN=https://agente-agente-chapelao.b1h6rm.easypanel.host
PORT=3000
NODE_ENV=production
SUPA_URL=https://qlswjefuinhbtlhauhgj.supabase.co
# A chave recebida em 15/10 retornou 401; copiar a chave publicável vigente do projeto.
SUPA_KEY=<chave-publicavel-valida>
# Somente no servidor: reutiliza consultas do catálogo existente.
SUPA_SERVICE_KEY=<segredo-do-projeto-no-servidor>
# Conexão direta ou Supavisor SESSION (5432); nunca transacional (6543).
# Usar sslmode=verify-full e CA confiável; não desativar verificação TLS.
DATABASE_URL=postgresql://<usuario>:<senha>@<host>:5432/postgres?sslmode=verify-full
# Opcional se a CA não estiver no trust store: PEM, via segredo de ambiente.
# DATABASE_CA_CERT=<certificado-CA-PEM>
EVOLUTION_URL=https://assistente-evolution-api.b1h6rm.easypanel.host
# Chapela - atendimento
EVOLUTION_PRIMARY_KEY=<chave-da-instancia-principal>
WEBHOOK_PRIMARY_SECRET=<segredo-aleatorio-de-64-caracteres>
# chapelao
EVOLUTION_SECONDARY_KEY=<chave-da-instancia-secundaria>
WEBHOOK_SECONDARY_SECRET=<outro-segredo-aleatorio-de-64-caracteres>
OPENAI_API_KEY=<chave-existente-no-Easypanel>
# Modelo compatível com tools e JSON, validado na sua conta. Sem troca automática.
OPENAI_MODEL=<modelo-validado-na-conta>
