# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPA_URL=https://XXXXXXXXXXXX.supabase.co
SUPA_KEY=eyJXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SUPA_SERVICE_KEY=eyJXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Anthropic (agente Claude Opus 5 + leitura de comprovante PIX) ────────────
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── OpenAI (só transcrição de áudio — a Anthropic não transcreve áudio) ──────
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Evolution API ─────────────────────────────────────────────────────────────
EVOLUTION_URL=https://sua-evolution-api.com
EVOLUTION_KEY=sua-api-key-aqui
EVOLUTION_INSTANCE=chapelao

# ─── Regras de negócio ────────────────────────────────────────────────────────
# Taxa de entrega FIXA, em reais. Fonte única da verdade: aparece no resumo,
# no pedido gravado e no cupom impresso. Se mudar, muda em todos de uma vez.
TAXA_ENTREGA=11
# Minutos de pausa do atendimento automático quando um atendente é chamado.
PAUSA_ATENDENTE_MIN=10
# Fuso do restaurante — usado para saber que dia é "hoje" nos itens do dia.
TZ_RESTAURANTE=America/Sao_Paulo

# ─── Ajuste fino do modelo (opcional) ─────────────────────────────────────────
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MODEL_VISAO=claude-opus-5
# ANTHROPIC_EFFORT=medium          # low | medium | high | xhigh | max
# ANTHROPIC_MAX_TOKENS=4096

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
