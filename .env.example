# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPA_URL=https://XXXXXXXXXXXX.supabase.co
SUPA_KEY=eyJXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SUPA_SERVICE_KEY=eyJXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── OpenAI (agente + leitura do comprovante PIX + transcrição de áudio) ─────
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Evolution API ─────────────────────────────────────────────────────────────
EVOLUTION_URL=https://sua-evolution-api.com
EVOLUTION_KEY=sua-api-key-aqui
EVOLUTION_INSTANCE=chapelao

# ─── Regras de negócio ────────────────────────────────────────────────────────
# Taxa de entrega FIXA, em reais. Aparece no resumo, no pedido gravado e no
# cupom impresso — os três leem daqui, então não têm como divergir.
# O banco (info_restaurante.taxa_entrega) também está em 11, porque o PAINEL
# lê de lá ao criar pedido manual. Se mudar um, mude o outro.
TAXA_ENTREGA=11

# ─── Opcionais (têm padrão no código, não precisa definir no EasyPanel) ──────
# PAUSA_ATENDENTE_MIN=10        # minutos de pausa quando um atendente é chamado
# MAX_FALHAS_AUDIO=2            # áudios ilegíveis seguidos antes de chamar gente
# TZ_RESTAURANTE=America/Sao_Paulo

# Modelo. gpt-5.6-terra é o equilíbrio entre acerto e velocidade.
# Mais preciso (e mais caro/lento): gpt-5.6-sol · Mais barato: gpt-5.6-luna
# OPENAI_MODEL=gpt-5.6-terra
# OPENAI_MODEL_VISAO=gpt-5.6-terra
# OPENAI_EFFORT=low             # none | minimal | low | medium | high | xhigh | max
# OPENAI_MAX_TOKENS=3000

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
