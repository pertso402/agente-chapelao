# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPA_URL=https://XXXXXXXXXXXX.supabase.co
SUPA_KEY=eyJXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SUPA_SERVICE_KEY=eyJXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── OpenAI (agente + leitura do comprovante PIX + transcrição de áudio) ─────
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Evolution API ─────────────────────────────────────────────────────────────
# EVOLUTION_URL é a raiz da API, SEM /manager no fim (o /manager é só a tela
# de administração no navegador; a API responde na raiz).
EVOLUTION_URL=https://assistente-evolution-api.b1h6rm.easypanel.host
EVOLUTION_KEY=coloque-a-apikey-da-instancia-aqui
# Nome EXATO da instância, com maiúsculas e espaços como aparecem no manager.
# O código escapa os espaços sozinho ao montar a URL.
EVOLUTION_INSTANCE=Chapela - atendimento

# O webhook fica do lado da Evolution, não aqui: aponte a instância para
# https://SEU-AGENTE/webhook com o evento MESSAGES_UPSERT.

# ─── Regras de negócio ────────────────────────────────────────────────────────
# A taxa de entrega NÃO é fixa: cada endereço é calculado à mão no painel.
# Este valor é só a rede de segurança — se ninguém digitar a taxa dentro do
# tempo limite, o agente assume ele e segue, pra não perder a venda.
# O mesmo número vive em info_restaurante.taxa_entrega_padrao, que dá pra
# mudar pelo banco sem publicar código.
TAXA_ENTREGA_PADRAO=11

# Minutos que o agente espera alguém digitar a taxa no painel.
# TIMEOUT_TAXA_MIN=5

# ─── Opcionais (têm padrão no código, não precisa definir no EasyPanel) ──────
# PAUSA_ATENDENTE_MIN=10        # minutos de pausa quando um atendente é chamado
# MAX_FALHAS_AUDIO=2            # áudios ilegíveis seguidos antes de chamar gente
# TZ_RESTAURANTE=America/Sao_Paulo
# ABRE_HORA=10:30            # aceita "10:30" ou hora cheia ("11")
# FECHA_HORA=14:00
# DIAS_ABERTOS=1,2,3,4,5,6      # 0=domingo … 6=sábado

# Modelo. gpt-5.6-terra é o equilíbrio entre acerto e velocidade.
# Mais preciso (e mais caro/lento): gpt-5.6-sol · Mais barato: gpt-5.6-luna
# OPENAI_MODEL=gpt-5.6-terra
# OPENAI_MODEL_VISAO=gpt-5.6-terra
# OPENAI_EFFORT=none            # O agente usa function tools, e no
#                               # /v1/chat/completions o gpt-5.6 so aceita
#                               # tools com effort "none". Nao mude sem testar.
# OPENAI_EFFORT_FOLLOWUP=low    # o follow-up nao usa tools, pode raciocinar
# OPENAI_MAX_TOKENS=3000

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
